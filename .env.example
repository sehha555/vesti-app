# Vesti Environment Variables
# Copy this file to .env.local and fill in the values

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Weather API
OPENWEATHER_API_KEY=

# Cloudinary (optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Smoke Test (for scripts/smoke_api.sh)
# 以下兩個只給 scripts/tests/smoke_api.sh 用，app 本身讀的是 NEXT_PUBLIC_ 開頭那組
SUPABASE_URL=
SUPABASE_ANON_KEY=
TEST_EMAIL=
TEST_PASSWORD=
BASE_URL=http://localhost:3000

# ---- Production 必填（缺了登入/註冊與 BFF API 會直接失敗）----
RATE_LIMIT_SECRET=
INTERNAL_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- 選填 ----
REMOVE_BG_API_KEY=
SIGNED_URL_EXPIRES_SECONDS=
ENABLE_LEGACY_OUTFITS_PAYLOAD=
RATELIMIT_PREFIX=
REDIS_URL=
DEPLOY_PLATFORM=
TRUST_X_FORWARDED_FOR=
NEXT_PUBLIC_VESTI_TEST_USER_ID=
