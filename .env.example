# Vesti Environment Variables
# Copy this file to .env.local and fill in the values

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Weather API
OPENWEATHER_API_KEY=

# Cloudinary (optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Smoke Test (for scripts/smoke_api.sh)
# 以下兩個只給 scripts/tests/smoke_api.sh 用，app 本身讀的是 NEXT_PUBLIC_ 開頭那組
SUPABASE_URL=
SUPABASE_ANON_KEY=
TEST_EMAIL=
TEST_PASSWORD=
BASE_URL=http://localhost:3000

# ---- Production 必填（缺了登入/註冊與 BFF API 會直接失敗）----
RATE_LIMIT_SECRET=
INTERNAL_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Gemini（每日搭配推薦用）
# 正式環境請用付費層：免費層的輸入可能被 Google 用來改進產品、可能人工審閱（見 docs/legal/link-out-compliance.md）
GEMINI_API_KEY=

# ---- 選填 ----
REMOVE_BG_API_KEY=
SIGNED_URL_EXPIRES_SECONDS=
ENABLE_LEGACY_OUTFITS_PAYLOAD=
RATELIMIT_PREFIX=
REDIS_URL=
DEPLOY_PLATFORM=
TRUST_X_FORWARDED_FOR=
# 可選：覆蓋搭配用的 Gemini 模型名稱（預設 gemini-3.7-flash）
GEMINI_MODEL=

# ---- 抓取商品頁（貼連結匯入）----
# VestiBot 的說明 / 聯絡頁，會附在 User-Agent 裡讓網站管理者找得到我們
VESTI_BOT_INFO_URL=
# 額外不抓取的網域（逗號分隔，含子網域）；權利人要求停止時加在這裡。蝦皮已內建封鎖
FETCH_BLOCKED_DOMAINS=
