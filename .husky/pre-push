# Pre-push hook: Run tests before pushing
# This ensures your changes pass tests before pushing to remote

# Allow skipping with: SKIP_TESTS=1 git push
if [ "${SKIP_TESTS:-}" = "1" ]; then
  echo "[SKIP] SKIP_TESTS=1 detected -> skipping pre-push tests"
  exit 0
fi

echo "[INFO] Running tests before push..."
echo ""

# Run vitest
if npm test -- --run; then
  echo ""
  echo "[OK] Tests passed - proceeding with push"
  exit 0
else
  echo ""
  echo "[FAIL] Tests failed - push aborted"
  echo ""
  echo "[TIP] To skip this check (not recommended), run:"
  echo "      SKIP_TESTS=1 git push"
  echo ""
  exit 1
fi
